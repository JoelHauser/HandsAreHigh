<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline checks for the 0.29.0 boss last-survivor rule and Raider classification, run against
       a BUILT Mercy.dll and the game's real WildSpawnType table (no game running).
       Run: dotnet run -c Release -p:SPTPath=H:\SPT4.1.X (from this folder). Exit code 0 = all pass. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <SPTPath Condition="'$(SPTPath)' == ''">H:\SPT4.1.X</SPTPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(SPTPath)\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(SPTPath)\BepInEx\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
